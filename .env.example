# Copy this file to ".env" (next to the ikabot executable / repo root) to
# override defaults. All values are optional.

# --- Regional context -------------------------------------------------------
# Gameforge rejects blackbox tokens whose regional context does not match the
# login request, so these must describe ONE consistent region. They are used
# for the login payload, every Accept-Language header, the lobby Referer URLs,
# the captcha challenge URLs, and the blackbox token request.
#
# IKABOT_GF_LANG defaults to the language part of IKABOT_LOCALE, so setting
# IKABOT_LOCALE alone is usually enough.

IKABOT_LOCALE=en-GB
IKABOT_GF_LANG=en
IKABOT_TIMEZONE_ID=Europe/London

# Examples for other regions:
#   IKABOT_LOCALE=de-DE
#   IKABOT_GF_LANG=de
#   IKABOT_TIMEZONE_ID=Europe/Berlin

# --- Multi-instance / Docker ------------------------------------------------
# Only needed when running several ikabot containers on one machine.
#
# Each container should keep its OWN ~/.ikabot (it holds the credential vault).
# Share these two directories instead:
#
# Where per-account status files are written, for a monitoring panel to read.
# Point every container at one shared volume. See docs/DOCKER_STATUS_API.md.
#   IKABOT_STATUS_DIR=/shared/status
#
# Where the local captcha solver claims CPU "seats", so instances do not all
# grab every core. Must be shared, and on a filesystem where flock works.
#   IKABOT_DECAPTCHA_SEAT_DIR=/shared/decaptcha_seats

# --- Self-hosted API fallback -----------------------------------------------
# ikabot asks a public API server for blackbox login tokens and pirate captcha
# solutions. When that server is down, logins stop. Point these at your own
# copy (docker/ikabot-api/) and ikabot falls back to it automatically.
#
# Comma-separated, tried in order after the public server.
#   IKABOT_API_FALLBACK=https://ikabot-api.example.com
#
# The X-API-Key your gate requires. Sent ONLY to the addresses above, never
# to the public server.
#   IKABOT_API_KEY=
#
# Seconds to wait for any one API server before giving up on it and trying
# the next. Token generation drives a real browser, so do not go too low.
#   IKABOT_API_TIMEOUT=120
