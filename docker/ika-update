#!/usr/bin/env python3
"""Update ikabot's own code from GitHub.

Replaces the Windows installer's "Update ikabot" screen. The previous copy is
kept so a bad update can be rolled back without another download.
"""

import argparse
import http.client
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import zipfile
from concurrent import futures
from pathlib import Path

REPO = os.environ.get("IKABOT_REPO", "kurzonmorris/ikabot-modules")
BRANCH = os.environ.get("IKABOT_BRANCH", "main")
APP = Path(os.environ.get("APP_DIR", "/app"))
BACKUP = APP / ".previous"

ZIP_URL = "https://codeload.github.com/%s/zip/refs/heads/%s" % (REPO, BRANCH)
TREE_URL = ("https://api.github.com/repos/%s/git/trees/%s?recursive=1"
            % (REPO, BRANCH))
RAW_URL = "https://raw.githubusercontent.com/%s/%s/" % (REPO, BRANCH)

# Copied wholesale from the downloaded tree; anything else in /app is left alone.
TRACKED = ("ikabot", "modules", "config-examples")

UA = {"User-Agent": "ika-update/2.0"}
# A dropped transfer raises http.client.IncompleteRead, which is an
# HTTPException and so is caught by none of urllib's error classes. Listing it
# here is what turns a network blip into a message instead of a traceback.
NET_ERRORS = (urllib.error.URLError, urllib.error.HTTPError,
              http.client.HTTPException, OSError)
# What main() will report rather than let escape as a traceback.
FAIL_ERRORS = NET_ERRORS + (zipfile.BadZipFile, RuntimeError, ValueError)

# 136 files over 136 fresh TLS handshakes is most of the wall time of an
# update, and one stalled handshake could eat four minutes of it on its own
# (four tries of a sixty-second timeout). Two of those and the caller's ten
# minutes are gone with nothing to show. So: a handful of connections, each
# reused, each given a short leash, and a budget for the whole job.
WORKERS = int(os.environ.get("IKA_UPDATE_WORKERS", "8"))
FILE_TIMEOUT = float(os.environ.get("IKA_UPDATE_FILE_TIMEOUT", "20"))
FILE_TRIES = 3
BUDGET = float(os.environ.get("IKA_UPDATE_BUDGET", "300"))


class SlowLink(RuntimeError):
    """The listing worked but the files will not come down in time.

    Its own class because the answer is not the answer to everything else:
    falling back to the full archive means pulling a quarter of a gigabyte
    over the link that has just proved too slow for nine megabytes.
    """



def versions(tree):
    """Read IKABOT_VERSION / IKABOT_MOD_VERSION out of a source tree."""
    cfg = Path(tree) / "ikabot" / "config.py"
    out = {}
    try:
        text = cfg.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return out
    for key in ("IKABOT_VERSION", "IKABOT_MOD_VERSION"):
        m = re.search(r'^%s\s*=\s*"([^"]+)"' % key, text, re.M)
        if m:
            out[key] = m.group(1)
    return out


def describe(v):
    if not v:
        return "unknown"
    return "ikabot %s / mod %s" % (v.get("IKABOT_VERSION", "?"),
                                   v.get("IKABOT_MOD_VERSION", "?"))


def get(url, tries=4, timeout=60):
    """Fetch a URL, retrying a dropped or refused transfer.

    A definite answer from the server -- not found, forbidden -- is returned
    at once rather than asked for three more times: it will not change, and
    the caller has a fallback that should be reached quickly. Only 429 and the
    5xx range are worth waiting out.
    """
    delay = 2
    for attempt in range(1, tries + 1):
        try:
            req = urllib.request.Request(url, headers=UA)
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                return resp.read()
        except urllib.error.HTTPError as exc:
            if exc.code < 500 and exc.code != 429:
                raise
            if attempt == tries:
                raise
            print("  retrying (%s)" % exc)
            time.sleep(delay)
            delay *= 2
        except NET_ERRORS as exc:
            if attempt == tries:
                raise
            print("  retrying (%s)" % exc)
            time.sleep(delay)
            delay *= 2


class RawPool:
    """Keep-alive connections to the raw file host, one per worker thread.

    urllib opens, negotiates and closes a connection for every single file.
    Reusing one connection per worker removes that handshake from 135 of the
    136 fetches; a connection that breaks or stalls is dropped and reopened
    rather than poisoning the rest of that worker's files.
    """

    def __init__(self, base):
        parts = urllib.parse.urlsplit(base)
        self.secure = parts.scheme != "http"
        self.host = parts.netloc
        self.root = parts.path or "/"
        self.local = threading.local()
        # Cancelling a future does nothing to one already running, and a
        # worker part-way through three tries of a twenty-second timeout would
        # otherwise hold the process open for another minute after the budget
        # is spent. Workers check this between attempts, which bounds the wait
        # at whatever single request is in flight.
        self.abort = threading.Event()

    def _conn(self):
        conn = getattr(self.local, "conn", None)
        if conn is None:
            cls = (http.client.HTTPSConnection if self.secure
                   else http.client.HTTPConnection)
            conn = cls(self.host, timeout=FILE_TIMEOUT)
            self.local.conn = conn
        return conn

    def _drop(self):
        conn = getattr(self.local, "conn", None)
        if conn is not None:
            try:
                conn.close()
            except Exception:
                pass
            self.local.conn = None

    def get(self, path):
        """Return one file's bytes, or raise after FILE_TRIES attempts."""
        url = self.root + urllib.parse.quote(path)
        last = None
        for attempt in range(1, FILE_TRIES + 1):
            if self.abort.is_set():
                raise RuntimeError("%s: given up on" % path)
            try:
                conn = self._conn()
                conn.request("GET", url, headers=UA)
                resp = conn.getresponse()
                body = resp.read()          # always, or the connection is unusable
                if resp.status == 200:
                    return body
                # A definite no is not worth asking three times; only an
                # overloaded or rate-limiting server is.
                if resp.status < 500 and resp.status != 429:
                    raise RuntimeError("%s: HTTP %d" % (path, resp.status))
                last = "HTTP %d" % resp.status
                self._drop()
            except NET_ERRORS as exc:
                last = str(exc) or exc.__class__.__name__
                self._drop()
            if attempt < FILE_TRIES and not self.abort.is_set():
                time.sleep(0.5 * attempt)
        raise RuntimeError("%s: %s" % (path, last))


def safe_under(root, rel):
    """Resolve rel under root, or None if it would escape.

    Paths come from GitHub, so they are checked rather than trusted: one
    entry of "../../usr/local/bin" would otherwise be written outside the
    temporary folder.
    """
    root = Path(root).resolve()
    target = (root / rel).resolve()
    if target != root and root not in target.parents:
        return None
    return target


def fetch_tracked(dest):
    """Download only ikabot, modules and config-examples.

    The repository archive is a quarter of a gigabyte -- it carries the
    releases, dist and archive folders -- while the code being updated is
    under a megabyte of it. One call lists the tree, then each wanted file
    comes from raw.githubusercontent, which is not rate limited. Falls back to
    the whole archive if anything about that is not available.
    """
    print("Listing %s (%s)..." % (REPO, BRANCH))
    tree = json.loads(get(TREE_URL, timeout=60).decode("utf-8"))
    if tree.get("truncated"):
        raise RuntimeError("tree listing truncated")

    wanted = []
    for entry in tree.get("tree", []):
        if entry.get("type") != "blob":
            continue
        path = entry.get("path", "")
        if any(path == name or path.startswith(name + "/") for name in TRACKED):
            wanted.append(path)
    if not wanted:
        raise RuntimeError("no %s files in the listing" % ", ".join(TRACKED))

    root = Path(dest) / "tree"
    wanted.sort()

    # Checked before a single byte is fetched: one entry of "../../usr/local
    # /bin" should stop the update, not be discovered halfway through it.
    targets = {}
    for path in wanted:
        target = safe_under(root, path)
        if target is None:
            raise RuntimeError("refusing path from the listing: %r" % path)
        targets[path] = target

    pool = RawPool(RAW_URL)
    started = time.time()
    deadline = started + BUDGET
    print("  %d file(s) to fetch" % len(wanted))
    done = 0

    # Not a "with": its exit waits for every running worker, which is the one
    # thing that must not happen when the budget has just run out.
    ex = futures.ThreadPoolExecutor(max_workers=WORKERS)
    jobs = {ex.submit(pool.get, path): path for path in wanted}
    pending = set(jobs)
    try:
        for fut in futures.as_completed(jobs, timeout=BUDGET):
            pending.discard(fut)
            path = jobs[fut]
            target = targets[path]
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(fut.result())
            done += 1
            if done % 25 == 0 or done == len(wanted):
                print("  %d/%d (%.0fs)" % (done, len(wanted),
                                           time.time() - started))
    except futures.TimeoutError:
        raise SlowLink(
            "gave up after %.0fs with %d of %d file(s) — the connection to "
            "%s is too slow or is being throttled"
            % (time.time() - started, done, len(wanted), pool.host))
    finally:
        pool.abort.set()
        for fut in pending:
            fut.cancel()
        ex.shutdown(wait=False)

    if time.time() > deadline:
        print("  (took longer than the %.0fs budget, but finished)" % BUDGET)
    return root


def fetch_zip(dest):
    """The whole repository archive: the fallback, streamed to disk.

    Written out in chunks rather than read into memory, and checked twice
    before it is trusted. A cut-off transfer does not always raise: with a
    Content-Length reply the read loop can simply end early and hand back a
    truncated file, so the bytes written are compared against the length the
    server declared. The archive is then opened, because a file of the right
    size can still be corrupt, and both failures are retried.
    """
    print("Downloading the full archive of %s (%s)..." % (REPO, BRANCH))
    blob = Path(dest) / "repo.zip"
    out = Path(dest) / "zip"
    delay = 2

    for attempt in range(1, 5):
        got = 0
        try:
            req = urllib.request.Request(ZIP_URL, headers=UA)
            with urllib.request.urlopen(req, timeout=120) as resp:
                declared = resp.headers.get("Content-Length")
                declared = int(declared) if declared and declared.isdigit() else 0
                with open(blob, "wb") as fh:
                    while True:
                        chunk = resp.read(1024 * 1024)
                        if not chunk:
                            break
                        fh.write(chunk)
                        got += len(chunk)
                        if got % (32 * 1024 * 1024) < 1024 * 1024:
                            print("  %.0f MB" % (got / 1048576.0))
            if declared and got != declared:
                raise http.client.IncompleteRead(b"", declared - got)

            print("  %.1f MB, unpacking" % (got / 1048576.0))
            if out.is_dir():
                shutil.rmtree(out)
            with zipfile.ZipFile(blob) as z:
                z.extractall(out)
            blob.unlink()
            break

        except (NET_ERRORS + (zipfile.BadZipFile,)) as exc:
            if attempt == 4:
                raise
            print("  transfer failed after %.0f MB (%s) — retrying"
                  % (got / 1048576.0, exc))
            time.sleep(delay)
            delay *= 2

    roots = [p for p in out.iterdir() if p.is_dir()]
    if len(roots) != 1:
        raise RuntimeError("unexpected archive layout: %s" % roots)
    return roots[0]


def find_root(base):
    """The folder inside *base* that holds ikabot/config.py.

    Accepts whatever shape the download happens to have: the repository zip
    unpacks to <repo>-<branch>/ikabot, a release zip to app/ikabot, and an
    already-extracted folder has ikabot at the top. Searched two levels deep,
    which covers all three without wandering off into the tree.
    """
    base = Path(base)
    if (base / "ikabot" / "config.py").is_file():
        return base
    for depth in (1, 2):
        for candidate in base.glob("/".join(["*"] * depth)):
            if candidate.is_dir() and (candidate / "ikabot" / "config.py").is_file():
                return candidate
    return None


def from_local(source, dest):
    """Use a zip or folder already on disk instead of downloading anything.

    For a connection too slow or too unreliable to pull even the small
    listing: fetch the archive by whatever means work, drop it in, and point
    this at it.
    """
    source = Path(source).expanduser()
    if not source.exists():
        raise RuntimeError("no such file or folder: %s" % source)

    if source.is_dir():
        root = find_root(source)
        if root is None:
            raise RuntimeError("%s does not contain ikabot/config.py" % source)
        print("Using %s" % root)
        return root

    print("Unpacking %s (%.1f MB)..."
          % (source.name, source.stat().st_size / 1048576.0))
    out = Path(dest) / "local"
    with zipfile.ZipFile(source) as z:
        z.extractall(out)
    root = find_root(out)
    if root is None:
        raise RuntimeError("%s has no ikabot/config.py in it — is it the "
                           "right archive?" % source.name)
    return root


def download(dest):
    try:
        return fetch_tracked(dest)
    except SlowLink as exc:
        # The fallback is a quarter-gigabyte archive. Offering that to a link
        # that has just failed to carry nine megabytes is not a fallback, it
        # is a longer wait before the same failure.
        raise RuntimeError(
            "%s.\n\nThe files are there and the versions were read, so this is "
            "the connection rather than the update.\n"
            "  - press it again: a throttled link usually clears in a few "
            "minutes\n"
            "  - or download the release zip by hand and install from it:\n"
            "      ika update --from /config/ikabot-docker_vX.Y.Z.zip" % exc)
    except Exception as exc:
        print("  could not fetch the file list (%s)" % exc)
        print("  falling back to the whole archive")
        return fetch_zip(dest)


def main():
    ap = argparse.ArgumentParser(prog="ika-update", description=__doc__)
    ap.add_argument("--yes", "-y", action="store_true",
                    help="do not ask for confirmation")
    ap.add_argument("--rollback", action="store_true",
                    help="restore the copy saved by the last update")
    ap.add_argument("--from", dest="source", metavar="PATH",
                    help="install from a zip or folder already on this "
                         "machine instead of downloading")
    args = ap.parse_args()

    if args.rollback:
        if not BACKUP.is_dir():
            print("Nothing to roll back to — no previous copy saved.", file=sys.stderr)
            return 1
        print("Restoring %s" % describe(versions(BACKUP)))
        for name in TRACKED:
            src = BACKUP / name
            if not src.is_dir():
                continue
            dst = APP / name
            if dst.is_dir():
                shutil.rmtree(dst)
            shutil.copytree(src, dst)
        print("Restored. Now run:  ika restart all")
        return 0

    tmp = tempfile.mkdtemp(prefix="ika-update-")
    try:
        try:
            new = from_local(args.source, tmp) if args.source else download(tmp)
        except FAIL_ERRORS as exc:
            if args.source:
                print("Could not use %s: %s" % (args.source, exc), file=sys.stderr)
                return 1
            print("Download failed: %s" % exc, file=sys.stderr)
            print("Check the server has internet access, and that IKABOT_BRANCH "
                  "(%s) exists." % BRANCH, file=sys.stderr)
            print("\nOn a slow connection, download the archive yourself and "
                  "use:\n  ika update --from /config/main.zip", file=sys.stderr)
            return 1

        if not (new / "ikabot" / "config.py").is_file():
            print("Downloaded archive has no ikabot/config.py — refusing to "
                  "touch %s." % APP, file=sys.stderr)
            return 1

        now, then = versions(APP), versions(new)
        print("\n  installed : %s" % describe(now))
        print("  available : %s\n" % describe(then))

        if now and now == then:
            print("Already up to date.")
            if not args.yes:
                reply = input("Reinstall anyway? [y/N]: ").strip().lower()
                if reply != "y":
                    return 0

        if not args.yes:
            print("This replaces ikabot's code in %s." % APP)
            print("Running instances keep going until you restart them.")
            reply = input("Continue? [y/N]: ").strip().lower()
            if reply != "y":
                print("Cancelled — nothing changed.")
                return 0

        # Keep exactly one previous copy so --rollback always has a target.
        if BACKUP.is_dir():
            shutil.rmtree(BACKUP)
        BACKUP.mkdir(parents=True)
        for name in TRACKED:
            src = APP / name
            if src.is_dir():
                shutil.copytree(src, BACKUP / name)

        for name in TRACKED:
            src = new / name
            if not src.is_dir():
                continue
            dst = APP / name
            if dst.is_dir():
                shutil.rmtree(dst)
            shutil.copytree(src, dst)
            print("  updated %s/" % name)

        print("\nRefreshing modules...")
        try:
            subprocess.run(["ika-modules", "sync", "--local"], check=False)
        except OSError as exc:
            # Never fail an otherwise-good update over the module refresh.
            print("  could not run ika-modules (%s) — run it yourself with:"
                  "  ika modules" % exc)

        print("\nUpdated to %s" % describe(versions(APP)))
        print("Previous copy saved — undo with:  ika update --rollback")
        print("\nNow restart the instances to load it:")
        print("  ika restart all")
        return 0
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main())
