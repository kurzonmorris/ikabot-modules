# Copy to ".env" next to docker-compose.yml on the Unraid box.
# This file holds secrets — keep it out of git and off any share you export.

# --- Required ---------------------------------------------------------------

# The shared secret every client must send as the X-API-Key header.
# Generate one and never reuse it anywhere else:
#   openssl rand -base64 48
IKABOT_API_KEY=

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → install token.
# The long string after "--token" in the command Cloudflare shows you.
TUNNEL_TOKEN=

# --- Optional ---------------------------------------------------------------

# Which upstream revision to build. "main" tracks the Ikabot Collective's
# latest; a tag or commit sha pins it, which is what you want on a box that
# rebuilds unattended.
#API_GIT_REF=main

# LAN port for the gate, for ikabot instances on the Unraid box and on the
# tailnet. They still need the API key.
#GATE_LAN_PORT=5080

# Resource ceiling for the browser that mints tokens.
#API_MEM_LIMIT=2g
#API_CPUS=2.0

# Discord webhook the API logs to. Leave empty unless you want that.
#LOGS_WEBHOOK_URL=
