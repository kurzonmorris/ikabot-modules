#!/bin/bash
# Maintenance commands inside the ikabot container.
# Replaces the Windows installer's maintenance menu.
set -uo pipefail

SESSION="${TMUX_SESSION:-ikabot}"
MODULES_DIR="${MODULES_DIR:-/config/modules}"
LOGS_DIR=/config/.ikabot/logs

usage() {
    cat <<'USAGE'
ika — ikabot container maintenance

  ika attach            Open the instance screens (Ctrl-B then D to leave)
  ika status            Show every instance and what it is using
  ika list              Show installed modules and their versions
  ika modules           Update modules from GitHub
  ika modules --local   Reinstall modules from the copy in the app folder
  ika update            Update ikabot itself from GitHub
  ika update --rollback Undo the last update
  ika restart <n>       Restart one instance, e.g.  ika restart 3
  ika restart all       Restart every instance
  ika restart dead      Restart only the crashed ones
  ika crash <n>         Show why an instance died
  ika web               Show each instance's web server URL
  ika web --stop        Stop every running instance web server
  ika logs              List account log files
  ika logs <name>       Follow one log file
  ika panel             Show the control panel address
  ika panel restart     Reload the panel after swapping in a new one
  ika shell             Plain shell inside the container

Leaving the screens: press Ctrl-B, let go, then press D.
Switching instance:  Ctrl-B then W picks from a list.
USAGE
}

win_name() { printf "ika%02d" "$1"; }

# Rebuild the launch command rather than letting tmux replay it: respawn-window
# does not remember the pane's start directory, so a bare respawn comes back up
# in the wrong place.
instance_cmd() {
    # Only pre-answer the account prompt when a vault exists — see entrypoint.sh.
    if [ "${AUTO_ACCOUNT:-1}" = "1" ] \
       && { [ -f /config/.ikabot/vault ] || [ -f /config/.ikabot_vault ]; }; then
        echo "python3 -m ikabot $1"
    else
        echo "python3 -m ikabot"
    fi
}

respawn() {
    local num="$1" win="$2"
    tmux respawn-window -k -c /app -t "$SESSION:$win" "$(instance_cmd "$num")" 2>/dev/null
}

cmd_status() {
    if ! tmux has-session -t "$SESSION" 2>/dev/null; then
        echo "No tmux session '$SESSION' — the container is not running instances."
        return 1
    fi

    printf "%-8s %-10s %-8s %s\n" "WINDOW" "STATE" "PID" "COMMAND"
    printf -- "------------------------------------------------------------\n"
    tmux list-windows -t "$SESSION" -F \
        "#{window_name}|#{pane_dead}|#{pane_pid}|#{pane_current_command}" \
    | while IFS='|' read -r name dead pid cmd; do
        if [ "$dead" = "1" ]; then
            printf "%-8s %-10s %-8s %s\n" "$name" "STOPPED" "-" "(exited)"
        else
            printf "%-8s %-10s %-8s %s\n" "$name" "running" "$pid" "$cmd"
        fi
    done

    echo
    local count rss
    count=$(pgrep -fc "python3 -m ikabot" 2>/dev/null || echo 0)
    rss=$(ps -eo rss,comm,args --no-headers 2>/dev/null \
          | awk '/ikabot/ {sum += $1} END {printf "%.0f", sum/1024}')
    echo "ikabot processes : ${count} running, ${rss:-0} MB resident in total"
    echo "modules folder   : ${MODULES_DIR}"
    echo "data folder      : /config/.ikabot"
}

cmd_restart() {
    local target="${1:-}"
    if [ -z "$target" ]; then
        echo "Which instance? e.g.  ika restart 3   or   ika restart all" >&2
        return 1
    fi

    # Only the crashed ones. remain-on-exit keeps a dead pane around holding
    # its traceback, so this leaves healthy instances (and their logins) alone.
    if [ "$target" = "dead" ]; then
        local any=0
        while IFS='|' read -r w d; do
            if [ "$d" = "1" ]; then
                local n="${w#ika}"
                if respawn "$((10#$n))" "$w"; then
                    echo "restarted $w"
                    any=1
                fi
            fi
        done < <(tmux list-windows -t "$SESSION" -F "#{window_name}|#{pane_dead}")
        if [ "$any" = "0" ]; then
            echo "No crashed instances — nothing to restart."
        fi
        return 0
    fi

    if [ "$target" = "all" ]; then
        for w in $(tmux list-windows -t "$SESSION" -F "#{window_name}"); do
            local n="${w#ika}"
            respawn "$((10#$n))" "$w" && echo "restarted $w"
        done
        return 0
    fi

    if ! [[ "$target" =~ ^[0-9]+$ ]]; then
        echo "Instance must be a number, or 'all'." >&2
        return 1
    fi

    local w
    w=$(win_name "$target")
    if respawn "$target" "$w"; then
        echo "restarted $w"
    else
        echo "No instance called $w" >&2
        return 1
    fi
}

cmd_web() {
    python3 - "$SESSION" "${1:-}" <<'PY'
import os, re, subprocess, sys

session = sys.argv[1]
stop = len(sys.argv) > 2 and sys.argv[2] == '--stop'

panes = {}
out = subprocess.run(["tmux", "list-windows", "-t", session,
                      "-F", "#{window_name} #{pane_pid}"],
                     capture_output=True, text=True).stdout
for line in out.split("\n"):
    if not line.strip():
        continue
    name, _, pid = line.rpartition(" ")
    panes[int(pid)] = name


def parent(pid):
    # /proc/<pid>/stat: field 4 is ppid, but comm can contain spaces and ')'
    try:
        with open("/proc/%d/stat" % pid) as f:
            return int(f.read().rpartition(")")[2].split()[1])
    except (OSError, IndexError, ValueError):
        return 0


def instance_of(pid):
    for _ in range(40):
        if pid in panes:
            return panes[pid]
        if pid <= 1:
            break
        pid = parent(pid)
    return None


def server_address():
    if os.environ.get("IKA_WEB_HOST"):
        return os.environ["IKA_WEB_HOST"]
    try:
        out = subprocess.run(["ip", "-4", "-o", "addr"],
                             capture_output=True, text=True).stdout
    except OSError:
        out = ""
    found = re.findall(r"inet (\d+\.\d+\.\d+\.\d+)", out)
    # Tailscale hands out 100.64.0.0/10, and that is the address worth
    # printing — it is the one that works from anywhere.
    for a in found:
        p = [int(x) for x in a.split(".")]
        if p[0] == 100 and 64 <= p[1] <= 127:
            return a
    for a in found:
        if not a.startswith(("127.", "172.17.")):
            return a
    return "<server-ip>"


def listening_ports_by_inode():
    """socket inode -> port, for every TCP socket in LISTEN state."""
    ports = {}
    for path in ("/proc/net/tcp", "/proc/net/tcp6"):
        try:
            with open(path) as f:
                next(f, None)
                for line in f:
                    col = line.split()
                    if len(col) < 10 or col[3] != "0A":   # 0A = TCP_LISTEN
                        continue
                    ports[col[9]] = int(col[1].rpartition(":")[2], 16)
        except OSError:
            pass
    return ports


def sockets_of(pid):
    """Socket inodes this process holds open."""
    out = []
    try:
        for fd in os.listdir("/proc/%d/fd" % pid):
            try:
                target = os.readlink("/proc/%d/fd/%s" % (pid, fd))
            except OSError:
                continue
            if target.startswith("socket:["):
                out.append(target[8:-1])
    except OSError:
        pass
    return out


ttyd_port = int(os.environ.get("TTYD_PORT", "7681"))
inode_port = listening_ports_by_inode()
rows = set()
owners = {}

for entry in os.listdir("/proc"):
    if not entry.isdigit():
        continue
    pid = int(entry)
    hits = [inode_port[i] for i in sockets_of(pid) if i in inode_port]
    if not hits:
        continue
    name = instance_of(pid)
    if not name:
        continue
    for port in hits:
        if port != ttyd_port:
            rows.add((name, port))
            owners[pid] = name

if not rows:
    print("No instance web servers are running.")
    if not stop:
        print("Start one from inside an instance with menu option (16).")
elif stop:
    import signal
    print("Stopping %d web server(s)..." % len(rows))
    for pid in sorted(owners):
        try:
            os.kill(pid, signal.SIGTERM)
            print("  stopped pid %d (%s)" % (pid, owners[pid]))
        except OSError as exc:
            print("  could not stop pid %d: %s" % (pid, exc))
    print("\nThe instances themselves are untouched.")
else:
    host = server_address()
    print("%-10s %-8s %s" % ("INSTANCE", "PORT", "URL"))
    print("-" * 52)
    for name, port in sorted(rows):
        print("%-10s %-8d http://%s:%d" % (name, port, host, port))
    print("\nReachable from anywhere on your tailnet.")
    print("Stop them all with:  ika web --stop")
PY
}

cmd_crash() {
    local target="${1:-}"
    if [ -z "$target" ] || ! [[ "$target" =~ ^[0-9]+$ ]]; then
        echo "Which instance? e.g.  ika crash 7" >&2
        return 1
    fi
    local w
    w=$(win_name "$target")
    if ! tmux list-windows -t "$SESSION" -F "#{window_name}" | grep -qx "$w"; then
        echo "No instance called $w" >&2
        return 1
    fi
    echo "--- last output from $w ---"
    tmux capture-pane -p -t "$SESSION:$w" | grep -vE "^[[:space:]]*$" | tail -30
}

# Finding the panel by the port it holds, rather than by matching its name:
# a name match also matches the very command doing the matching.
panel_pid() {
    python3 - "${PANEL_PORT:-7682}" <<'PY'
import os, sys
want = int(sys.argv[1])
ports = {}
for path in ("/proc/net/tcp", "/proc/net/tcp6"):
    try:
        with open(path) as f:
            next(f, None)
            for line in f:
                c = line.split()
                if len(c) > 9 and c[3] == "0A":
                    ports[c[9]] = int(c[1].rpartition(":")[2], 16)
    except OSError:
        pass
for entry in os.listdir("/proc"):
    if not entry.isdigit():
        continue
    pid = int(entry)
    try:
        fds = os.listdir("/proc/%d/fd" % pid)
    except OSError:
        continue
    for fd in fds:
        try:
            target = os.readlink("/proc/%d/fd/%s" % (pid, fd))
        except OSError:
            continue
        if target.startswith("socket:[") and ports.get(target[8:-1]) == want:
            print(pid)
            sys.exit(0)
PY
}

cmd_panel() {
    local host port
    port="${PANEL_PORT:-7682}"

    if [ "${1:-}" != "restart" ]; then
        host="$(ika-panel-host)"
        echo "Control panel: http://${host}:${port}"
        echo "Sign in with TTYD_USER / TTYD_PASS (or PANEL_USER / PANEL_PASS)."
        if [ -n "$(panel_pid)" ]; then
            echo "Status: running"
        else
            echo "Status: NOT running — start it with:  ika panel restart"
        fi
        return 0
    fi

    local pid
    pid="$(panel_pid)"
    if [ -n "$pid" ]; then
        kill "$pid" 2>/dev/null && echo "stopped panel (pid $pid)"
        sleep 1
    fi

    if [ -z "${PANEL_PASS:-${TTYD_PASS:-}}" ]; then
        echo "No PANEL_PASS or TTYD_PASS set — the panel will not serve without one." >&2
        return 1
    fi

    PANEL_PASS="${PANEL_PASS:-$TTYD_PASS}" PANEL_PORT="$port" \
        nohup ika-panel >> "$LOGS_DIR/panel.log" 2>&1 &
    sleep 1
    if [ -n "$(panel_pid)" ]; then
        echo "panel restarted on port $port"
    else
        echo "panel did not come up — check $LOGS_DIR/panel.log" >&2
        return 1
    fi
}

cmd_logs() {
    local name="${1:-}"
    if [ -z "$name" ]; then
        if [ -d "$LOGS_DIR" ] && [ -n "$(ls -A "$LOGS_DIR" 2>/dev/null)" ]; then
            ls -lh "$LOGS_DIR"
            echo
            echo "Follow one with:  ika logs <filename>"
        else
            echo "No logs yet in $LOGS_DIR"
        fi
        return 0
    fi
    tail -f "$LOGS_DIR/$name"
}

case "${1:-}" in
    attach|"")   exec tmux attach -t "$SESSION" ;;
    status)      cmd_status ;;
    list)        exec ika-modules list ;;
    modules)     shift; exec ika-modules sync "$@" ;;
    update)      shift; exec ika-update "$@" ;;
    restart)     shift; cmd_restart "$@" ;;
    web)         shift; cmd_web "${1:-}" ;;
    crash)       shift; cmd_crash "$@" ;;
    logs)        shift; cmd_logs "$@" ;;
    panel)       shift; cmd_panel "${1:-}" ;;
    shell)       exec /bin/bash ;;
    -h|--help|help) usage ;;
    *)           echo "Unknown command: $1" >&2; echo; usage; exit 1 ;;
esac
