{
  "manifest_version": 3,
  "name": "Vinted ↔ Shopify Sync",
  "version": "0.1.0",
  "description": "Keeps a Vinted wardrobe and a Shopify clothing store in parity: listings, prices, stock and status.",
  "minimum_chrome_version": "114",

  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs"
  ],

  "host_permissions": [
    "https://*.vinted.co.uk/*",
    "https://*.vinted.com/*",
    "https://*.vinted.fr/*",
    "https://*.vinted.de/*",
    "https://*.vinted.pl/*",
    "https://*.vinted.es/*",
    "https://*.vinted.it/*",
    "https://*.vinted.nl/*",
    "https://*.myshopify.com/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_title": "Vinted ↔ Shopify Sync",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.vinted.co.uk/*",
        "https://*.vinted.com/*",
        "https://*.vinted.fr/*",
        "https://*.vinted.de/*",
        "https://*.vinted.pl/*",
        "https://*.vinted.es/*",
        "https://*.vinted.it/*",
        "https://*.vinted.nl/*"
      ],
      "js": ["src/content/vinted.js"],
      "run_at": "document_idle"
    }
  ]
}
